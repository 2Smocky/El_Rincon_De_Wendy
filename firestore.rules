rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: claves_wendy
// Document ID: {claveId} (password slug; provisioned out-of-band, strictly read-only)
// Fields:
//   - active: bool
//   - createdAt: string
//
// Collection: progreso_wendy
// Document ID: 'estado_mapa' (single state document)
// Fields:
//   - unlocked: bool (required; once true, cannot revert to false)
//   - openedIds: list (required, max 30 items; cannot shrink on update)
//   - historyByDate: map (required, max 60 entries)
//   - finaleUnlocked: bool (required)
//   - updatedAt: timestamp | string (required; timestamp / serverTimestamp or string <= 64 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated (reserved for future auth-gated rules)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure UID field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate non-empty string within length bounds
    function isValidString(value, minLen, maxLen) {
      return value is string &&
        value.size() >= minLen &&
        value.size() <= maxLen;
    }

    // Validate timestamp or bounded date string (supports serverTimestamp -> request.time)
    function isValidTimestampOrString(value) {
      return value is timestamp || isValidString(value, 1, 64);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProgresoEstado(data) {
      return hasOnlyAllowedFields(data, [
          'unlocked',
          'openedIds',
          'historyByDate',
          'finaleUnlocked',
          'updatedAt'
        ]) &&
        hasRequiredFields(data, [
          'unlocked',
          'openedIds',
          'historyByDate',
          'finaleUnlocked',
          'updatedAt'
        ]) &&
        data.unlocked is bool &&
        data.openedIds is list &&
        data.openedIds.size() <= 30 &&
        data.historyByDate is map &&
        data.historyByDate.size() <= 60 &&
        data.finaleUnlocked is bool &&
        isValidTimestampOrString(data.updatedAt);
    }

    function isValidProgresoTransition(newData, oldData) {
      return (!('openedIds' in oldData) ||
          !(oldData.openedIds is list) ||
          newData.openedIds.size() >= oldData.openedIds.size()) &&
        (!('unlocked' in oldData) ||
          oldData.unlocked != true ||
          newData.unlocked == true);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Password slug lookup (get by exact ID only; never listable or writable)
    match /claves_wendy/{claveId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Single shared map progress document ('estado_mapa')
    match /progreso_wendy/{docId} {
      allow get: if docId == 'estado_mapa';
      allow list: if false;
      allow create: if docId == 'estado_mapa' &&
        isValidProgresoEstado(request.resource.data);
      allow update: if docId == 'estado_mapa' &&
        isValidProgresoEstado(request.resource.data) &&
        isValidProgresoTransition(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Default deny all other collections and subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
